@top Document { (Component | Attribute | Design | EnumDeclaration | StructDeclaration | TokensDeclaration | I18nDeclaration | StyleDeclaration | UseDeclaration | Node)* }
@skip { space | LineComment | BlockComment }
@precedence { call, typed, member @left, prefix, multiply @left, add @left, compare @left, equal @left, and @left, or @left, pipe @left, nullish @left, conditional @right }

Component { component ComponentName (":" ComponentName)? Block }
Design { design ComponentName "{" (DesignOverride | DesignState)* "}" }
DesignOverride { TypeName Block }
DesignState { state String Block }
Attribute { "#[" AttributeName Arguments? "]" }
Block { "{" (Node | If | For | Property | Attribute | Override | PropDeclaration | StateDeclaration | LetDeclaration | EventDeclaration | EnumDeclaration | StructDeclaration | TokensDeclaration | I18nDeclaration | StyleDeclaration | ApplyStatement | UseDeclaration | SlotDeclaration | SlotFill | ShortcutDeclaration | Forward | GroupMatch)* "}" }
Override { override (PropertyName | String) (Block ";"? | ":" Value+ ";" | from String (Block ";"? | ";")) }
PropDeclaration { required? prop PropertyName ":" TypeReference ("=" Value+)? ";" }
StateDeclaration { state PropertyName ":" TypeReference ("=" Value+)? ";" }
LetDeclaration { let PropertyName "=" Value+ ";" }
UseDeclaration { use String ";"? }
EventDeclaration { event PropertyName "(" (Parameter ("," Parameter)* ","?)? ")" ";" }
Parameter { PropertyName ":" TypeReference }
TypeReference { SingleType ("|" SingleType)* }
SingleType { TypeName ("<" TypeReference ("," TypeReference)* ">")? "?"? }
EnumDeclaration { enum TypeName "{" (TypeName ("," TypeName)* ","?)? "}" ";"? }
StructDeclaration { struct TypeName "{" (StructField (("," | ";") StructField)* ("," | ";")?)? "}" ";"? }
StructField { Attribute* PropertyName ":" TypeReference }
TokensDeclaration { tokens (PropertyName | TypeName)? "{" (PropertyName ":" Value+ ";")* "}" ";"? }
I18nDeclaration { i18n (PropertyName | TypeName)? "{" (PropertyName ":" Value+ ";")* "}" ";"? }
StyleDeclaration { style (PropertyName | TypeName) "{" Property* "}" ";"? }
ApplyStatement { apply (PropertyName | TypeName) ("," (PropertyName | TypeName))* ";" }
SlotDeclaration { slot PropertyName SlotArgs? (ChildBlock ";"? | ";") }
SlotArgs { "(" (PropertyName ":" Value+ ("," PropertyName ":" Value+)* ","?)? ")" }
SlotFill { "@" PropertyName SlotParams? ChildBlock ";"? }
SlotParams { "(" (PropertyName ("," PropertyName)* ","?)? ")" }
ShortcutDeclaration { shortcut String EventArrow Call ";" }
Forward { forward props "{" (PropertyName ("," PropertyName)* ","?)? "}" ";" }
Node { TypeName Block }
If { if Value ChildBlock (else (If | ChildBlock))? }
For { for PropertyName ("," PropertyName)? in Value (where Value)? (key Value)? ChildBlock (empty ChildBlock)? }
ChildBlock { "{" (Node | If | For | LetDeclaration | GroupMatch)* "}" }
Property { PropertyName (":" Value+ | Binding Path | EventArrow Call) ";" }
Value {
  String | Number | Color | Boolean | Null | Star | Dash | Array | Object | Match | Call | Path | TypedValue | Parenthesized |
  UnaryExpression | BinaryExpression | ConditionalExpression | MemberExpression
}
Parenthesized { "(" Value ")" }
UnaryExpression { ("!" | "+" | Dash) !prefix Value }
BinaryExpression {
  Value !multiply (Star | "/" | "%") Value |
  Value !add ("+" | Dash) Value |
  Value !compare (Comparison | RangeOp) Value |
  Value !equal Equality Value |
  Value !and "&&" Value |
  Value !or "||" Value |
  Value !pipe PipeOp (Call | Path) |
  Value !nullish "??" Value
}
ConditionalExpression { Value !conditional "?" Value ":" Value }
MemberExpression { Value !member (("." | "?.") PropertyName | "[" Value "]" | "?." "[" Value "]") }
TypedValue { TypeName !typed Block }
Array { "[" (Value ("," Value)* ","?)? "]" }
Object { "{" ((PropertyName | String) ":" Value+ ((";" | ",") (PropertyName | String) ":" Value+)* (";" | ",")?)? "}" }
Call { Path !call Arguments }
Arguments { "(" (Value ("," Value)* ","?)? ")" }
Match { match Subject "{" Branch* "}" }
GroupMatch { match Subject "{" GroupBranch* "}" ";"? }
Subject { Value | Tuple }
Tuple { "(" Value ("," Value)+ ")" }
Branch { Pattern (if Value)? MatchArrow Value+ ";" }
GroupBranch { Pattern (if Value)? MatchArrow ("{" (Property | Node | If | For | LetDeclaration | GroupMatch)* "}" ";"? | Node ";"?) }
Pattern { SinglePattern ("|" SinglePattern)* }
SinglePattern { Wildcard | Boolean | Null | String | Number (RangeOp Number)? | Path | Dash Number | Comparison Number | "(" Pattern ("," Pattern)+ ")" }
Path { Identifier | TypeName }
ComponentName { TypeName }
PropertyName { Identifier }
AttributeName { Identifier | design | use }
component { @specialize<Identifier, "component"> }
design { @specialize<Identifier, "design"> }
match { @specialize<Identifier, "match"> }
override { @specialize<Identifier, "override"> }
from { @specialize<Identifier, "from"> }
prop { @specialize<Identifier, "prop"> }
let { @specialize<Identifier, "let"> }
use { @extend<Identifier, "use"> }
where { @extend<Identifier, "where"> }
required { @specialize<Identifier, "required"> }
event { @specialize<Identifier, "event"> }
enum { @specialize<Identifier, "enum"> }
struct { @specialize<Identifier, "struct"> }
tokens { @extend<Identifier, "tokens"> }
i18n { @extend<Identifier, "i18n"> }
style { @extend<Identifier, "style"> }
apply { @extend<Identifier, "apply"> }
slot { @extend<Identifier, "slot"> }
shortcut { @specialize<Identifier, "shortcut"> }
forward { @specialize<Identifier, "forward"> }
props { @specialize<Identifier, "props"> }
if { @specialize<Identifier, "if"> }
else { @specialize<Identifier, "else"> }
for { @specialize<Identifier, "for"> }
in { @specialize<Identifier, "in"> }
key { @extend<Identifier, "key"> }
state { @extend<Identifier, "state"> }
empty { @specialize<Identifier, "empty"> }
Boolean { @specialize<Identifier, "true"> | @specialize<Identifier, "false"> }
Null { @specialize<Identifier, "null"> }
Wildcard { @specialize<Identifier, "_"> }

@external tokens strings from "./forma-tokens.js" { String }

@tokens {
  space { $[ \t\n\r]+ }
  LineComment { "//" ![\n]* }
  BlockComment { "/*" (![*] | "*" ![/])* "*/" }
  Number { $[0-9]+ ("." $[0-9]+)? ("px" | "rem" | "em" | "vw" | "vh" | "vmin" | "vmax" | "ch" | "ms" | "s" | "deg" | "rad" | "turn" | "%" | "fr" | "*")? }
  Color { "#" $[0-9a-fA-F]+ }
  TypeName { $[A-Z] $[a-zA-Z0-9_.]* }
  Identifier { $[a-z_] $[a-zA-Z0-9_.]* }
  Binding { "<->" }
  EventArrow { "->" }
  MatchArrow { "=>" }
  RangeOp { "..=" | ".." }
  PipeOp { "|>" }
  Comparison { "<=" | ">=" | "<" | ">" }
  Equality { "==" | "!=" | "===" | "!==" }
  Star { "*" }
  Dash { "-" }
  @precedence { LineComment, BlockComment, "/" }
  @precedence { RangeOp, Number }
}
