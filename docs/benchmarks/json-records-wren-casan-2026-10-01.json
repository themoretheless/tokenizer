{
  "method": "functional parity; no timings",
  "cases": [
    {
      "case": "empty",
      "accepted": true,
      "expected": [],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "unicode-order-filter",
      "accepted": true,
      "expected": [
        {
          "group": "Б\"\n",
          "total": 1.5
        },
        {
          "group": "next",
          "total": -4.0
        }
      ],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "inactive",
      "accepted": true,
      "expected": [],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "zero",
      "accepted": true,
      "expected": [
        {
          "group": "a",
          "total": 0.0
        }
      ],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "empty-and-nul-keys",
      "accepted": true,
      "expected": [
        {
          "group": "",
          "total": 0.0
        },
        {
          "group": "\u0000",
          "total": 3.0
        }
      ],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "inactive-before-active",
      "accepted": true,
      "expected": [
        {
          "group": "a",
          "total": 2.0
        },
        {
          "group": "b",
          "total": 3.0
        }
      ],
      "rush_stderr": "",
      "wren_verified": true,
      "wren_stderr": ""
    },
    {
      "case": "not-array",
      "accepted": false,
      "expected": null,
